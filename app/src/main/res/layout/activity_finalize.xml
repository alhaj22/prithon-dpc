<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="64sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prithon Enterprise Guard"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device Owner enrollment confirmed.\nHardware security policies and 0-KB offline protection are established."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnCompleteSetup"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="FINISH &amp; CONTINUE TO DEVICE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/green_success"
        android:textColor="@color/white" />

</LinearLayout>
