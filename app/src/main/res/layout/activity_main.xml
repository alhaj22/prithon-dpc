<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:padding="28dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_lock"
        android:tint="@color/blue_primary"
        android:contentDescription="Shield Icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="PRITHON DEVICE GUARD"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Checking Device Owner Status..."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textAlignment="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID: Scanning..."
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvServerEndpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Server: Connecting..."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnTestLock"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:text="TEST LOCAL HARDWARE LOCK"
        android:backgroundTint="@color/red_alert"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
