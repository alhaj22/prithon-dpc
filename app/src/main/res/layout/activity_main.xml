<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="Prithon Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRITHON FINANCE GUARD"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking Security Status..."
                    android:textColor="@color/green_success"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Permissions Action Banner (Shown when Device Admin or Overlay is missing) -->
        <LinearLayout
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_warning_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ SECURITY PERMISSIONS REQUIRED"
                android:textColor="@color/yellow_pending"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant Device Admin and Overlay permissions to enable remote lock from dashboard."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnGrantAdmin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="1. ACTIVATE DEVICE ADMIN (MANDATORY)"
                android:backgroundTint="@color/primary_brand"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="2. ENABLE DISPLAY OVER APPS"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="3. ENABLE ANTI-POWER-OFF GUARD"
                android:backgroundTint="#475569"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Customer Summary Card (Shown when details are saved) -->
        <LinearLayout
            android:id="@+id/cardCustomerSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="18dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMER ONBOARDING ACTIVE"
                android:textColor="@color/blue_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: Ramesh Sharma"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSummaryPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone: +91 9876543210"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSummaryShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Code: APX-4021"
                android:textColor="@color/cyan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSummaryImei"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMEI: 860123456789012"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSummaryLoan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan ID: PRITHON-1024"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSummaryEmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly EMI: ₹2,500"
                android:textColor="@color/green_success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnEditCustomer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Edit Details"
                android:textSize="12sp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/input_bg"
                android:textColor="@color/blue_primary" />
        </LinearLayout>

        <!-- Customer Registration Form -->
        <LinearLayout
            android:id="@+id/cardCustomerForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Details &amp; Loan Setup"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter customer KYC details to register this financed device."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Field 0: Retailer / Shop Code -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop / Retailer Code *"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTenantCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. APX-4021"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="textCapCharacters"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Field 1: Customer Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Full Name *"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomerName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. Ramesh Kumar"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="textPersonName"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Field 2: Mobile Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Mobile Number *"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomerPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 9876543210"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="phone"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Field: Device IMEI (15 Digits) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device IMEI Number (15 Digits) *"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etEnteredImei"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 860123456789012"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="number"
                android:maxLength="15"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Field 3: Loan ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan / Finance Account ID"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLoanId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. LN-88301"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="textCapCharacters"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Field 4: Monthly EMI Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly EMI Amount (INR)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etEmiAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 2500"
                android:textColorHint="@color/text_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_input_white"
                android:paddingHorizontal="14dp"
                android:inputType="number"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnSaveCustomer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="ACTIVATE &amp; SYNC WITH SERVER"
                android:backgroundTint="@color/primary_brand"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Device Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID: ..."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvServerEndpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server: ..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Danger Zone: Deactivate Admin & Uninstall -->
        <Button
            android:id="@+id/btnDeactivateAndUninstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🗑️ DEACTIVATE ADMIN &amp; UNINSTALL APP"
            android:backgroundTint="@color/red_bg"
            android:textColor="@color/red_alert"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
