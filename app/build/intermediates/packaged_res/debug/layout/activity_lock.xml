<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/device_locked_title"
            android:textColor="@color/red_alert"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/device_locked_desc"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textAlignment="center"
            android:lineSpacingExtra="3dp" />

        <!-- Mock BharatQR / Payment Container -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            android:background="@color/white"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="@color/black"
                android:contentDescription="UPI BharatQR Code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SCAN VIA GPAY / PHONEPE"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚡ Auto-Unlocks in &lt; 3s post payment"
            android:textColor="@color/green_success"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Offline PIN entry -->
        <EditText
            android:id="@+id/etUnlockPin"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:hint="@string/unlock_pin_hint"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:inputType="numberPassword"
            android:gravity="center"
            android:background="@color/card_dark" />

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/unlock_btn"
            android:backgroundTint="@color/blue_primary"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- RBI Universal Emergency Access Button -->
        <Button
            android:id="@+id/btnEmergency"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="@string/emergency_call_btn"
            android:backgroundTint="#333333"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- Customer Helpline -->
        <Button
            android:id="@+id/btnSupport"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="@string/support_call_btn"
            android:backgroundTint="@color/card_dark"
            android:textColor="@color/text_muted" />

    </LinearLayout>
</ScrollView>
